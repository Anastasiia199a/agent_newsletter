# Скопируйте этот файл в .env и заполните.

# Claude API — ключ с https://console.anthropic.com (платно).
# Оставьте пустым — агент будет бесплатно использовать шаблонные тексты.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# SMTP. По умолчанию Brevo SMTP relay (серверы в ЕС, статистика открытий в кабинете Brevo).
# Логин и SMTP-ключ: Brevo → Settings → SMTP & API → SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Отправитель — адрес на вашем домене, подтверждённом в Brevo (SPF/DKIM).
MAIL_FROM="Online Tabak Shop <newsletter@onlinetabakshop.de>"
# Куда приходит черновик на согласование
ADMIN_EMAIL=
# Адрес для отписки (mailto-ссылка в письме и заголовок List-Unsubscribe)
UNSUBSCRIBE_EMAIL=abmelden@onlinetabakshop.de
